#ifndef com_sun_star_ai_ProviderRequest_idl
#define com_sun_star_ai_ProviderRequest_idl

module com { module sun { module star { module ai {

/** Request payload — mirrors docs/schemas/provider-request.schema.json.

    Day-0 fields only; future fields (streaming, tools, attachments)
    will be added without breaking layout (UNO struct evolution rules).
 */
struct ProviderRequest
{
    /** Capability requested, e.g. "rewrite" / "summarize" / "intent-to-uno".
        Must be in the active provider's listCapabilities() output. */
    string capability;

    /** Natural-language prompt or instruction. */
    string prompt;

    /** Optional context (selected text, document snippet, etc.).
        Empty string for no context. */
    string context;

    /** Maximum wait before giving up, in milliseconds.
        0 means use provider default (typically 30000). */
    long timeoutMs;
};

}; }; }; };

#endif

