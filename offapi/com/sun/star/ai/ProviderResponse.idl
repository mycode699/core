#ifndef com_sun_star_ai_ProviderResponse_idl
#define com_sun_star_ai_ProviderResponse_idl

module com { module sun { module star { module ai {

/** Response payload — caller must check status before reading content.

    Status values:
      "ok"             — content is valid LLM output
      "policy-denied"  — service mode forbids this capability/context
      "timeout"        — provider exceeded timeoutMs
      "provider-error" — backend failure; content holds error message
 */
struct ProviderResponse
{
    string status;
    string content;

    /** Evidence record id; empty when status != "ok".
        Format: "ev-YYYYMMDD-<sha256-12>". */
    string evidenceId;

    /** Wall-clock duration in milliseconds (provider-side measurement). */
    long durationMs;
};

}; }; }; };

#endif

