<?xml version="1.0" encoding="UTF-8"?>
<!-- Stage1 shell: no scrolled/notebook/grid — WorkDashboard-like flat layout for macOS. -->
<interface domain="sfx">
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkBox" id="AIChatPanel">
    <property name="visible">True</property>
    <property name="can-focus">False</property>
    <property name="orientation">vertical</property>
    <property name="spacing">8</property>
    <property name="border-width">10</property>
    <child>
      <object class="GtkLabel" id="panel_title_label">
        <property name="visible">True</property>
        <property name="halign">start</property>
        <property name="label" translatable="yes" context="aichat|title">可圈 AI</property>
        <attributes>
          <attribute name="weight" value="bold"/>
        </attributes>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="status_label">
        <property name="visible">True</property>
        <property name="halign">start</property>
        <property name="wrap">True</property>
        <property name="xalign">0</property>
        <property name="label">可圈 AI 就绪 · 写回须批准</property>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="agent_step_bar">
        <property name="visible">True</property>
        <property name="halign">start</property>
        <property name="xalign">0</property>
        <property name="label">步骤：待命</property>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="activity_card">
        <property name="visible">True</property>
        <property name="halign">start</property>
        <property name="wrap">True</property>
        <property name="xalign">0</property>
        <property name="label">选区后可改写/润色；批准后写回主文档</property>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="approval_action_row">
        <property name="visible">True</property>
        <property name="orientation">horizontal</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkLabel" id="approval_hint_label">
            <property name="visible">True</property>
            <property name="hexpand">True</property>
            <property name="xalign">0</property>
            <property name="label">写回须人工批准</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="chat_approve_btn">
            <property name="visible">True</property>
            <property name="label">批准写回</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="chat_diff_btn">
            <property name="visible">True</property>
            <property name="label">查看 Diff</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="chat_reject_btn">
            <property name="visible">True</property>
            <property name="label">拒绝</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="chat_undo_btn">
            <property name="visible">True</property>
            <property name="label">撤销写回</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="selection_chip_row">
        <property name="visible">True</property>
        <property name="orientation">horizontal</property>
        <property name="spacing">4</property>
        <child>
          <object class="GtkButton" id="selection_chip_btn">
            <property name="visible">True</property>
            <property name="label">选区：无</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="task_bootstrap_chip">
            <property name="visible">True</property>
            <property name="label">理解：待命</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="pending_plan_chip">
            <property name="visible">True</property>
            <property name="label">待批：无</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkTextView" id="transcript_view">
        <property name="visible">True</property>
        <property name="hexpand">True</property>
        <property name="vexpand">False</property>
        <property name="editable">False</property>
        <property name="wrap-mode">word-char</property>
        <property name="cursor-visible">False</property>
        <property name="height-request">160</property>
      </object>
    </child>
    <child>
      <object class="GtkEntry" id="prompt_entry">
        <property name="visible">True</property>
        <property name="hexpand">True</property>
        <property name="placeholder-text">描述你要做的事…</property>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="chat_action_box">
        <property name="visible">True</property>
        <property name="orientation">horizontal</property>
        <property name="spacing">4</property>
        <child>
          <object class="GtkButton" id="send_button">
            <property name="visible">True</property>
            <property name="label">发送</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="cancel_button">
            <property name="visible">True</property>
            <property name="label">取消</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="retry_button">
            <property name="visible">True</property>
            <property name="label">重试</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="clear_history_button">
            <property name="visible">True</property>
            <property name="label">清空</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="intent_rewrite_btn">
            <property name="visible">True</property>
            <property name="label">改写</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="intent_formal_btn">
            <property name="visible">True</property>
            <property name="label">正式</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="intent_proofread_btn">
            <property name="visible">True</property>
            <property name="label">校对</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="routing_diag_label">
            <property name="visible">True</property>
            <property name="hexpand">True</property>
            <property name="xalign">0</property>
            <property name="label">模型：…</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="scenario_btn_row">
        <property name="visible">True</property>
        <property name="orientation">horizontal</property>
        <property name="spacing">4</property>
        <child>
          <object class="GtkButton" id="scenario_btn_0">
            <property name="visible">True</property>
            <property name="label">公文润色</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="scenario_btn_1">
            <property name="visible">True</property>
            <property name="label">内容质检</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="scenario_btn_2">
            <property name="visible">True</property>
            <property name="label">排版优化</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="scenario_btn_3">
            <property name="visible">True</property>
            <property name="label">写作</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="run_scenario_btn">
            <property name="visible">True</property>
            <property name="label">运行方案</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
