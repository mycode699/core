<?xml version="1.0" encoding="UTF-8"?>
<interface domain="sfx">
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkBox" id="AIChatPanel">
    <property name="visible">True</property>
    <property name="can-focus">False</property>
    <property name="hexpand">True</property>
    <property name="vexpand">True</property>
    <property name="border-width">0</property>
    <property name="orientation">vertical</property>
    <property name="spacing">0</property>
    <!-- Panel title bar -->
    <child>
      <object class="GtkBox" id="panel_title_box">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="orientation">horizontal</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkLabel" id="panel_title_label">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="hexpand">True</property>
            <property name="halign">start</property>
            <property name="label" translatable="yes" context="aichat|panel_title">AI 工作区</property>
            <attributes>
              <attribute name="weight" value="bold"/>
            </attributes>
            <child internal-child="accessible">
              <object class="AtkObject" id="panel_title_label-atkobject">
                <property name="AtkObject::accessible-name" translatable="yes" context="aichat|panel_title">AI Workspace</property>
                <property name="AtkObject::accessible-role">static</property>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
            <property name="position">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkLabel" id="status_label">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="halign">end</property>
            <property name="label" translatable="yes" context="aichat|status_ready">就绪 — 可输入或点方案按钮</property>
            <attributes>
              <attribute name="weight" value="bold"/>
            </attributes>
            <child internal-child="accessible">
              <object class="AtkObject" id="status_label-atkobject">
                <property name="AtkObject::accessible-role">static</property>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">1</property>
          </packing>
        </child>
        <child>
          <object class="GtkButton" id="ai_settings_button">
            <property name="label" translatable="yes" context="aichat|settings">设置</property>
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="tooltip-text" translatable="yes" context="aichat|settings_tip">打开「工具 → 选项 → 语言设置 → 可圈 AI」配置多角色模型</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">False</property>
            <property name="position">2</property>
          </packing>
        </child>
      </object>
      <packing>
        <property name="expand">False</property>
        <property name="fill">True</property>
        <property name="position">0</property>
      </packing>
    </child>
    <child>
      <object class="GtkLabel" id="agent_step_bar">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="halign">start</property>
        <property name="margin-start">8</property>
        <property name="margin-end">8</property>
        <property name="margin-bottom">2</property>
        <property name="label" translatable="yes" context="aichat|agent_step_bar">步骤：待命</property>
        <property name="wrap">True</property>
        <property name="xalign">0</property>
        <child>
          <object class="AtkObject" id="agent_step_bar-atkobject">
            <property name="AtkObject::accessible-name" translatable="yes" context="aichat|agent_step_bar">Agent steps</property>
            <property name="AtkObject::accessible-role">static</property>
          </object>
        </child>
      </object>
      <packing>
        <property name="expand">False</property>
        <property name="fill">True</property>
        <property name="position">1</property>
      </packing>
    </child>
    <!-- 4-tab notebook -->
    <child>
      <object class="GtkNotebook" id="main_notebook">
        <property name="visible">True</property>
        <property name="can-focus">True</property>
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <property name="tab-pos">top</property>
        <!-- Tab 1: Chat -->
        <child>
          <object class="GtkBox" id="chat_tab">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="orientation">vertical</property>
            <property name="spacing">4</property>
            <property name="border-width">4</property>
            <child>
              <object class="GtkScrolledWindow" id="transcript_scroller">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <property name="shadow-type">none</property>
                <child>
                  <object class="GtkTextView" id="transcript_view">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="editable">False</property>
                    <property name="wrap-mode">word-char</property>
                    <property name="left-margin">6</property>
                    <property name="right-margin">6</property>
                    <property name="top-margin">6</property>
                    <property name="bottom-margin">6</property>
                    <child internal-child="accessible">
                      <object class="AtkObject" id="transcript_view-atkobject">
                        <property name="AtkObject::accessible-name" translatable="yes" context="aichat|transcript">AI chat transcript</property>
                        <property name="AtkObject::accessible-description" translatable="yes" context="aichat|extended_tip|transcript">Shows the current AI chat messages.</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkBox" id="scenario_box">
                <property name="visible">True</property>
                <property name="orientation">vertical</property>
                <property name="spacing">4</property>
                <child>
                  <object class="GtkBox" id="scenario_toolbar_row">
                    <property name="visible">True</property>
                    <property name="orientation">horizontal</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel" id="scenario_surface_label">
                        <property name="visible">True</property>
                        <property name="label">当前：—</property>
                        <property name="halign">start</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="opt_follow_doc">
                        <property name="label" translatable="yes" context="aichat|follow_doc">跟随文档</property>
                        <property name="visible">True</property>
                        <property name="active">True</property>
                        <property name="tooltip-text" translatable="yes" context="aichatpanel|opt_follow_doc.tooltip_text">打开文档时自动切换到对应分类 Tab</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="refresh_scenarios_btn">
                        <property name="label" translatable="yes" context="aichat|refresh_scenarios">刷新</property>
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="selection_chip_row">
                    <property name="visible">True</property>
                    <property name="orientation">horizontal</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkButton" id="selection_chip_btn">
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="hexpand">True</property>
                        <property name="halign">fill</property>
                        <property name="label">选区：—（点击刷新）</property>
                        <property name="tooltip-text" translatable="yes" context="aichatpanel|selection_chip_btn.tooltip_text">显示当前选区位置与长度；点击刷新。写回前请先选中内容。</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="pending_plan_chip">
                        <property name="visible">True</property>
                        <property name="label">计划：无</property>
                        <property name="halign">end</property>
                        <property name="tooltip-text" translatable="yes" context="aichatpanel|pending_plan_chip.tooltip_text">已暂存、待批准的写回计划</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="routing_diag_row">
                    <property name="visible">True</property>
                    <property name="orientation">horizontal</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkButton" id="routing_diag_btn">
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="label" translatable="yes" context="aichat|routing_diag">模型诊断</property>
                        <property name="tooltip-text" translatable="yes" context="aichatpanel|routing_diag_btn.tooltip_text">探测 Ollama 与五槽（主/轻量/Agent/规划/审查）解析；轻量槽用于后台总结，审查槽用于校对类方案</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="routing_diag_label">
                        <property name="visible">True</property>
                        <property name="hexpand">True</property>
                        <property name="halign">start</property>
                        <property name="wrap">True</property>
                        <property name="label">路由：未诊断</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="scenario_tab_row">
                    <property name="visible">True</property>
                    <property name="orientation">horizontal</property>
                    <property name="spacing">4</property>
                    <property name="homogeneous">True</property>
                    <child>
                      <object class="GtkRadioButton" id="tab_writer">
                        <property name="label" translatable="yes" context="aichat|tab_writer">写作</property>
                        <property name="visible">True</property>
                        <property name="active">True</property>
                        <property name="draw-indicator">False</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkRadioButton" id="tab_calc">
                        <property name="label" translatable="yes" context="aichat|tab_calc">表格</property>
                        <property name="visible">True</property>
                        <property name="draw-indicator">False</property>
                        <property name="group">tab_writer</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkRadioButton" id="tab_impress">
                        <property name="label" translatable="yes" context="aichat|tab_impress">演示</property>
                        <property name="visible">True</property>
                        <property name="draw-indicator">False</property>
                        <property name="group">tab_writer</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkRadioButton" id="tab_general">
                        <property name="label" translatable="yes" context="aichat|tab_general">通用</property>
                        <property name="visible">True</property>
                        <property name="draw-indicator">False</property>
                        <property name="group">tab_writer</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="scenario_pinned_row">
                    <property name="visible">True</property>
                    <property name="orientation">horizontal</property>
                    <property name="spacing">4</property>
                    <child>
                      <object class="GtkLabel" id="scenario_pinned_label">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes" context="aichat|pinned">常用</property>
                        <property name="halign">start</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="scenario_pin_0"><property name="visible">False</property><property name="can-focus">True</property><property name="label"> </property></object>
                    </child>
                    <child>
                      <object class="GtkButton" id="scenario_pin_1"><property name="visible">False</property><property name="can-focus">True</property><property name="label"> </property></object>
                    </child>
                    <child>
                      <object class="GtkButton" id="scenario_pin_2"><property name="visible">False</property><property name="can-focus">True</property><property name="label"> </property></object>
                    </child>
                    <child>
                      <object class="GtkButton" id="scenario_pin_3"><property name="visible">False</property><property name="can-focus">True</property><property name="label"> </property></object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkGrid" id="scenario_btn_grid">
                    <property name="visible">True</property>
                    <property name="column-spacing">4</property>
                    <property name="row-spacing">4</property>
                    <property name="column-homogeneous">True</property>
                    <!-- 12 fixed slots: 3 columns × 4 rows; rebound at runtime -->
                    <child>
                      <object class="GtkButton" id="scenario_btn_0"><property name="visible">False</property><property name="can-focus">True</property><property name="label"> </property></object>
                      <packing><property name="left-attach">0</property><property name="top-attach">0</property></packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="scenario_btn_1"><property name="visible">False</property><property name="can-focus">True</property><property name="label"> </property></object>
                      <packing><property name="left-attach">1</property><property name="top-attach">0</property></packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="scenario_btn_2"><property name="visible">False</property><property name="can-focus">True</property><property name="label"> </property></object>
                      <packing><property name="left-attach">2</property><property name="top-attach">0</property></packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="scenario_btn_3"><property name="visible">False</property><property name="can-focus">True</property><property name="label"> </property></object>
                      <packing><property name="left-attach">0</property><property name="top-attach">1</property></packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="scenario_btn_4"><property name="visible">False</property><property name="can-focus">True</property><property name="label"> </property></object>
                      <packing><property name="left-attach">1</property><property name="top-attach">1</property></packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="scenario_btn_5"><property name="visible">False</property><property name="can-focus">True</property><property name="label"> </property></object>
                      <packing><property name="left-attach">2</property><property name="top-attach">1</property></packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="scenario_btn_6"><property name="visible">False</property><property name="can-focus">True</property><property name="label"> </property></object>
                      <packing><property name="left-attach">0</property><property name="top-attach">2</property></packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="scenario_btn_7"><property name="visible">False</property><property name="can-focus">True</property><property name="label"> </property></object>
                      <packing><property name="left-attach">1</property><property name="top-attach">2</property></packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="scenario_btn_8"><property name="visible">False</property><property name="can-focus">True</property><property name="label"> </property></object>
                      <packing><property name="left-attach">2</property><property name="top-attach">2</property></packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="scenario_btn_9"><property name="visible">False</property><property name="can-focus">True</property><property name="label"> </property></object>
                      <packing><property name="left-attach">0</property><property name="top-attach">3</property></packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="scenario_btn_10"><property name="visible">False</property><property name="can-focus">True</property><property name="label"> </property></object>
                      <packing><property name="left-attach">1</property><property name="top-attach">3</property></packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="scenario_btn_11"><property name="visible">False</property><property name="can-focus">True</property><property name="label"> </property></object>
                      <packing><property name="left-attach">2</property><property name="top-attach">3</property></packing>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="scenario_more_row">
                    <property name="visible">True</property>
                    <property name="orientation">horizontal</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel" id="label_more_scenario">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes" context="aichat|more">更多：</property>
                        <property name="mnemonic-widget">scenario_picker</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkComboBoxText" id="scenario_picker">
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="run_scenario_btn">
                        <property name="label" translatable="yes" context="aichat|run_scenario">执行</property>
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="scenario_opts_row">
                    <property name="visible">True</property>
                    <property name="orientation">horizontal</property>
                    <property name="spacing">12</property>
                    <child>
                      <object class="GtkCheckButton" id="opt_attach_selection">
                        <property name="label" translatable="yes" context="aichat|opt_sel">附带选区</property>
                        <property name="visible">True</property>
                        <property name="active">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="opt_agent_pipeline">
                        <property name="label" translatable="yes" context="aichat|opt_agent">多步 Agent</property>
                        <property name="visible">True</property>
                        <property name="active">False</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="opt_doc_context">
                        <property name="label" translatable="yes" context="aichat|opt_ctx">文档上下文</property>
                        <property name="visible">True</property>
                        <property name="active">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkEntry" id="prompt_entry">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="hexpand">True</property>
                <property name="placeholder-text" translatable="yes" context="aichat|prompt">点上方方案按钮执行，或输入消息…</property>
                <child internal-child="accessible">
                  <object class="AtkObject" id="prompt_entry-atkobject">
                    <property name="AtkObject::accessible-name" translatable="yes" context="aichat|prompt_entry">AI chat prompt</property>
                    <property name="AtkObject::accessible-description" translatable="yes" context="aichat|extended_tip|prompt_entry">Enter a prompt or use @mentions and /slash commands.</property>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkBox" id="chat_action_box">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="halign">end</property>
                <property name="orientation">horizontal</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkButton" id="filter_workspace_button">
                    <property name="label" translatable="yes" context="aichatpanel|filter_workspace">筛选</property>
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="receives-default">True</property>
                    <child internal-child="accessible">
                      <object class="AtkObject" id="filter_workspace_button-atkobject">
                        <property name="AtkObject::accessible-description" translatable="yes" context="aichatpanel|extended_tip|filter_workspace">Filters workspace artifacts, reviews, and evidence by metadata only.</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkButton" id="sort_workspace_button">
                    <property name="label" translatable="yes" context="aichatpanel|sort_workspace">排序</property>
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="receives-default">True</property>
                    <child internal-child="accessible">
                      <object class="AtkObject" id="sort_workspace_button-atkobject">
                        <property name="AtkObject::accessible-description" translatable="yes" context="aichatpanel|extended_tip|sort_workspace">Sorts workspace lists by recent, type, or state metadata.</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                    <property name="position">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkButton" id="voice_button">
                    <property name="label" translatable="yes" context="aichat|voice">语音</property>
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="tooltip-text" translatable="yes" context="aichat|voice_tip">微信式语音：点按开始/结束；F4 快捷键；系统听写（Fn）或本地 STT（设置可配）</property>
                    <child internal-child="accessible">
                      <object class="AtkObject" id="voice_button-atkobject">
                        <property name="AtkObject::accessible-name" translatable="yes" context="aichat|voice">Voice input</property>
                        <property name="AtkObject::accessible-description" translatable="yes" context="aichat|extended_tip|voice">Push-to-talk or system dictation for the AI prompt.</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                    <property name="position">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkButton" id="screenshot_button">
                    <property name="label" translatable="yes" context="aichat|screenshot">截图</property>
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="tooltip-text" translatable="yes" context="aichat|screenshot_tip">选区截图（Ctrl/Cmd+Shift+A），保存并附到对话</property>
                    <child internal-child="accessible">
                      <object class="AtkObject" id="screenshot_button-atkobject">
                        <property name="AtkObject::accessible-name" translatable="yes" context="aichat|screenshot">Screenshot region</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                    <property name="position">3</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkButton" id="screenshot_win_button">
                    <property name="label" translatable="yes" context="aichat|screenshot_win">窗</property>
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="tooltip-text" translatable="yes" context="aichatpanel|screenshot_win_button.tooltip_text">窗口截图</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                    <property name="position">4</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkButton" id="screenshot_full_button">
                    <property name="label" translatable="yes" context="aichat|screenshot_full">全</property>
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
