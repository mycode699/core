<?xml version="1.0" encoding="UTF-8"?>
<interface domain="sfx">
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkBox" id="AIChatPanel">
    <property name="visible">True</property>
    <property name="can-focus">False</property>
    <property name="hexpand">True</property>
    <property name="vexpand">True</property>
    <property name="border-width">0</property>
    <property name="orientation">vertical</property>
    <property name="spacing">0</property>
    <!-- Panel title bar -->
    <child>
      <object class="GtkBox" id="panel_title_box">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="orientation">horizontal</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkLabel" id="panel_title_label">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="hexpand">True</property>
            <property name="halign">start</property>
            <property name="label" translatable="yes" context="aichat|panel_title">AI 工作区</property>
            <attributes>
              <attribute name="weight" value="bold"/>
            </attributes>
            <child internal-child="accessible">
              <object class="AtkObject" id="panel_title_label-atkobject">
                <property name="AtkObject::accessible-name" translatable="yes" context="aichat|panel_title">AI Workspace</property>
                <property name="AtkObject::accessible-role">static</property>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
            <property name="position">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkLabel" id="status_label">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="halign">end</property>
            <property name="label">State: ready</property>
            <attributes>
              <attribute name="weight" value="bold"/>
            </attributes>
            <child internal-child="accessible">
              <object class="AtkObject" id="status_label-atkobject">
                <property name="AtkObject::accessible-role">static</property>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">1</property>
          </packing>
        </child>
      </object>
      <packing>
        <property name="expand">False</property>
        <property name="fill">True</property>
        <property name="position">0</property>
      </packing>
    </child>
    <!-- 4-tab notebook -->
    <child>
      <object class="GtkNotebook" id="main_notebook">
        <property name="visible">True</property>
        <property name="can-focus">True</property>
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <property name="tab-pos">top</property>
        <!-- Tab 1: Chat -->
        <child>
          <object class="GtkBox" id="chat_tab">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="orientation">vertical</property>
            <property name="spacing">4</property>
            <property name="border-width">4</property>
            <child>
              <object class="GtkScrolledWindow" id="transcript_scroller">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <property name="shadow-type">in</property>
                <child>
                  <object class="GtkTextView" id="transcript_view">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="editable">False</property>
                    <property name="wrap-mode">word-char</property>
                    <property name="left-margin">6</property>
                    <property name="right-margin">6</property>
                    <property name="top-margin">6</property>
                    <property name="bottom-margin">6</property>
                    <child internal-child="accessible">
                      <object class="AtkObject" id="transcript_view-atkobject">
                        <property name="AtkObject::accessible-name" translatable="yes" context="aichat|transcript">AI chat transcript</property>
                        <property name="AtkObject::accessible-description" translatable="yes" context="aichat|extended_tip|transcript">Shows the current AI chat messages.</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkEntry" id="prompt_entry">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="hexpand">True</property>
                <property name="placeholder-text" translatable="yes" context="aichat|prompt">输入消息或使用 / 命令...</property>
                <child internal-child="accessible">
                  <object class="AtkObject" id="prompt_entry-atkobject">
                    <property name="AtkObject::accessible-name" translatable="yes" context="aichat|prompt_entry">AI chat prompt</property>
                    <property name="AtkObject::accessible-description" translatable="yes" context="aichat|extended_tip|prompt_entry">Enter a prompt or use @mentions and /slash commands.</property>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkBox" id="chat_action_box">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="halign">end</property>
                <property name="orientation">horizontal</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkButton" id="send_button">
                    <property name="label" translatable="yes" context="aichat|send">发送</property>
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="receives-default">True</property>
                    <child internal-child="accessible">
                      <object class="AtkObject" id="send_button-atkobject">
                        <property name="AtkObject::accessible-description" translatable="yes" context="aichat|extended_tip|send">Sends the prompt to the AI chat runtime.</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkButton" id="cancel_button">
                    <property name="label" translatable="yes" context="aichat|cancel">停止</property>
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="receives-default">True</property>
                    <child internal-child="accessible">
                      <object class="AtkObject" id="cancel_button-atkobject">
                        <property name="AtkObject::accessible-description" translatable="yes" context="aichat|extended_tip|cancel">Stops the current AI chat request.</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                    <property name="position">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkButton" id="retry_button">
                    <property name="label" translatable="yes" context="aichat|retry">重试</property>
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="receives-default">True</property>
                    <child internal-child="accessible">
                      <object class="AtkObject" id="retry_button-atkobject">
                        <property name="AtkObject::accessible-description" translatable="yes" context="aichat|extended_tip|retry">Restores the last prompt for another attempt.</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                    <property name="position">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkButton" id="clear_history_button">
                    <property name="label" translatable="yes" context="aichat|clear_history">清除历史</property>
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="receives-default">True</property>
                    <child internal-child="accessible">
                      <object class="AtkObject" id="clear_history_button-atkobject">
                        <property name="AtkObject::accessible-description" translatable="yes" context="aichat|extended_tip|clear_history">Clears local AI chat history for the current document.</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                    <property name="position">3</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">2</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="position">0</property>
          </packing>
        </child>
        <child type="tab">
          <object class="GtkLabel" id="chat_tab_label">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="label" translatable="yes" context="aichat|tab_chat">聊天</property>
          </object>
          <packing>
            <property name="position">0</property>
            <property name="tab-fill">False</property>
          </packing>
        </child>
        <!-- Tab 2: Agent -->
        <child>
          <object class="GtkBox" id="agent_tab">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="orientation">vertical</property>
            <property name="spacing">4</property>
            <property name="border-width">4</property>
            <child>
              <object class="GtkScrolledWindow" id="agent_scroller">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <property name="shadow-type">in</property>
                <child>
                  <object class="GtkTreeView" id="agent_tree">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="headers-visible">True</property>
                    <child internal-child="accessible">
                      <object class="AtkObject" id="agent_tree-atkobject">
                        <property name="AtkObject::accessible-name" translatable="yes" context="aichat|agent_tree">Agent tasks</property>
                        <property name="AtkObject::accessible-description" translatable="yes" context="aichat|extended_tip|agent_tree">Lists agent tasks for the current workspace.</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkTreeViewColumn" id="agent_task_column">
                        <property name="title" translatable="yes" context="aichat|agent_task">Task</property>
                        <property name="resizable">True</property>
                        <child>
                          <object class="GtkCellRendererText" id="agent_task_cell"/>
                          <attributes>
                            <attribute name="text">0</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkTreeViewColumn" id="agent_status_column">
                        <property name="title" translatable="yes" context="aichat|agent_status">Status</property>
                        <property name="resizable">True</property>
                        <child>
                          <object class="GtkCellRendererText" id="agent_status_cell"/>
                          <attributes>
                            <attribute name="text">1</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="position">1</property>
          </packing>
        </child>
        <child type="tab">
          <object class="GtkLabel" id="agent_tab_label">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="label" translatable="yes" context="aichat|tab_agent">Agent</property>
          </object>
          <packing>
            <property name="position">1</property>
            <property name="tab-fill">False</property>
          </packing>
        </child>
        <!-- Tab 3: Content -->
        <child>
          <object class="GtkBox" id="content_tab">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="orientation">vertical</property>
            <property name="spacing">4</property>
            <property name="border-width">4</property>
            <child>
              <object class="GtkScrolledWindow" id="content_scroller">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <property name="shadow-type">in</property>
                <child>
                  <object class="GtkListBox" id="content_listbox">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="selection-mode">single</property>
                    <child internal-child="accessible">
                      <object class="AtkObject" id="content_listbox-atkobject">
                        <property name="AtkObject::accessible-name" translatable="yes" context="aichat|content_listbox">Content objects</property>
                        <property name="AtkObject::accessible-description" translatable="yes" context="aichat|extended_tip|content_listbox">Lists content objects for the current workspace.</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkBox" id="content_action_box">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="halign">end</property>
                <property name="orientation">horizontal</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkButton" id="open_artifact_button">
                    <property name="label" translatable="yes" context="aichat|open_artifact">打开</property>
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="receives-default">True</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkButton" id="remove_artifact_button">
                    <property name="label" translatable="yes" context="aichat|remove_artifact">移除</property>
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="receives-default">True</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                    <property name="position">1</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="position">2</property>
          </packing>
        </child>
        <child type="tab">
          <object class="GtkLabel" id="content_tab_label">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="label" translatable="yes" context="aichat|tab_content">内容</property>
          </object>
          <packing>
            <property name="position">2</property>
            <property name="tab-fill">False</property>
          </packing>
        </child>
        <!-- Tab 4: Review -->
        <child>
          <object class="GtkBox" id="review_tab">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="orientation">vertical</property>
            <property name="spacing">4</property>
            <property name="border-width">4</property>
            <child>
              <object class="GtkScrolledWindow" id="review_scroller">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <property name="shadow-type">in</property>
                <child>
                  <object class="GtkTreeView" id="review_tree">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="headers-visible">True</property>
                    <child internal-child="accessible">
                      <object class="AtkObject" id="review_tree-atkobject">
                        <property name="AtkObject::accessible-name" translatable="yes" context="aichat|review_tree">Review queue</property>
                        <property name="AtkObject::accessible-description" translatable="yes" context="aichat|extended_tip|review_tree">Lists pending review items for the current workspace.</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkTreeViewColumn" id="review_item_column">
                        <property name="title" translatable="yes" context="aichat|review_item">Item</property>
                        <property name="resizable">True</property>
                        <child>
                          <object class="GtkCellRendererText" id="review_item_cell"/>
                          <attributes>
                            <attribute name="text">0</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkTreeViewColumn" id="review_state_column">
                        <property name="title" translatable="yes" context="aichat|review_state">State</property>
                        <property name="resizable">True</property>
                        <child>
                          <object class="GtkCellRendererText" id="review_state_cell"/>
                          <attributes>
                            <attribute name="text">1</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkBox" id="review_action_box">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="halign">end</property>
                <property name="orientation">horizontal</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkButton" id="approve_selected_button">
                    <property name="label" translatable="yes" context="aichat|approve_selected">批准</property>
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="receives-default">True</property>
                    <child internal-child="accessible">
                      <object class="AtkObject" id="approve_selected_button-atkobject">
                        <property name="AtkObject::accessible-description" translatable="yes" context="aichat|extended_tip|approve_selected">Approves the selected review item.</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkButton" id="reject_selected_button">
                    <property name="label" translatable="yes" context="aichat|reject_selected">拒绝</property>
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="receives-default">True</property>
                    <child internal-child="accessible">
                      <object class="AtkObject" id="reject_selected_button-atkobject">
                        <property name="AtkObject::accessible-description" translatable="yes" context="aichat|extended_tip|reject_selected">Rejects the selected review item.</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                    <property name="position">1</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="position">3</property>
          </packing>
        </child>
        <child type="tab">
          <object class="GtkLabel" id="review_tab_label">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="label" translatable="yes" context="aichat|tab_review">审核</property>
          </object>
          <packing>
            <property name="position">3</property>
            <property name="tab-fill">False</property>
          </packing>
        </child>
      </object>
      <packing>
        <property name="expand">True</property>
        <property name="fill">True</property>
        <property name="position">1</property>
      </packing>
    </child>
  </object>
</interface>