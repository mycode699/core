                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkButton" id="open_artifact_button">
                        <property name="label" translatable="yes" context="aichat|open_artifact">打开</property>
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="receives-default">True</property>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">False</property>
                        <property name="position">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="open_diff_review_button">
                        <property name="label" translatable="yes" context="aichatpanel|open_diff_review">查看 Diff</property>
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="receives-default">True</property>
                        <property name="tooltip-text" translatable="yes" context="aichatpanel|open_diff_review_tip">打开差异审阅预览（不自动写回）</property>
                        <child internal-child="accessible">
                          <object class="AtkObject" id="open_diff_review_button-atkobject">
                            <property name="AtkObject::accessible-description" translatable="yes" context="aichatpanel|extended_tip|open_diff_review">通过差异审阅打开所选项预览，不会自动写入主文档。</property>
                          </object>
                        </child>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">False</property>
                        <property name="position">1</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="review_artifact_button">
                        <property name="label" translatable="yes" context="aichatpanel|review_artifact">审查</property>
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="receives-default">True</property>
                        <child internal-child="accessible">
                          <object class="AtkObject" id="review_artifact_button-atkobject">
                            <property name="AtkObject::accessible-description" translatable="yes" context="aichatpanel|extended_tip|review_artifact">为所选产物创建带证据链接的内容审查项。</property>
                          </object>
                        </child>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">False</property>
                        <property name="position">2</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="format_artifact_button">
                        <property name="label" translatable="yes" context="aichatpanel|format_artifact">排版审查</property>
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="receives-default">True</property>
                        <child internal-child="accessible">
                          <object class="AtkObject" id="format_artifact_button-atkobject">
                            <property name="AtkObject::accessible-description" translatable="yes" context="aichatpanel|extended_tip|format_artifact">为所选产物创建带证据链接的排版与布局审查项。</property>
                          </object>
                        </child>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">False</property>
                        <property name="position">3</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="inspect_evidence_button">
                        <property name="label" translatable="yes" context="aichatpanel|inspect_evidence">证据</property>
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="receives-default">True</property>
                        <child internal-child="accessible">
                          <object class="AtkObject" id="inspect_evidence_button-atkobject">
                            <property name="AtkObject::accessible-description" translatable="yes" context="aichatpanel|extended_tip|inspect_evidence">打开所选产物的脱敏证据与引用链接元数据。</property>
                          </object>
                        </child>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">False</property>
                        <property name="position">4</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="copy_reference_button">
                        <property name="label" translatable="yes" context="aichatpanel|copy_reference">引用</property>
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="receives-default">True</property>
                        <child internal-child="accessible">
                          <object class="AtkObject" id="copy_reference_button-atkobject">
                            <property name="AtkObject::accessible-description" translatable="yes" context="aichatpanel|extended_tip|copy_reference">复制所选产物、审核项或证据的元数据引用。</property>
                          </object>
                        </child>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">False</property>
                        <property name="position">5</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="export_evidence_button">
                        <property name="label" translatable="yes" context="aichatpanel|export_evidence">导出证据</property>
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="receives-default">True</property>
                        <child internal-child="accessible">
                          <object class="AtkObject" id="export_evidence_button-atkobject">
                            <property name="AtkObject::accessible-description" translatable="yes" context="aichatpanel|extended_tip|export_evidence">导出所选项目的脱敏元数据与仅哈希的证据引用。</property>
                          </object>
                        </child>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">False</property>
                        <property name="position">6</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="remove_artifact_button">
                        <property name="label" translatable="yes" context="aichat|remove_artifact">移除</property>
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="receives-default">True</property>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">False</property>
                        <property name="position">7</property>
                      </packing>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">3</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="position">2</property>
          </packing>
        </child>
        <child type="tab">
          <object class="GtkLabel" id="content_tab_label">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="label" translatable="yes" context="aichat|tab_content">产物</property>
          </object>
          <packing>
            <property name="position">2</property>
            <property name="tab-fill">False</property>
          </packing>
        </child>
        <!-- Tab 4: Review queue -->
        <child>
          <object class="GtkBox" id="review_tab">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="orientation">vertical</property>
            <property name="spacing">6</property>
            <property name="border-width">6</property>
            <child>
              <object class="GtkLabel" id="review_hint_label">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="halign">start</property>
                <property name="wrap">True</property>
                <property name="label" translatable="yes" context="aichat|review_hint">审核队列：生成后待批计划会出现在此。流程：对话生成 → 查看 Diff → 批准写回/拒绝 → 主文档才改动。也可从「产物」页加入审查。</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkBox" id="review_toolbar">
                <property name="visible">True</property>
                <property name="orientation">horizontal</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkButton" id="review_refresh_btn">
                    <property name="label" translatable="yes" context="aichat|review_refresh">刷新队列</property>
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="review_scroller">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <property name="shadow-type">none</property>
                <child>
                  <object class="GtkTreeView" id="review_tree">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="headers-visible">True</property>
                    <child internal-child="accessible">
                      <object class="AtkObject" id="review_tree-atkobject">
                        <property name="AtkObject::accessible-name" translatable="yes" context="aichat|review_tree">审核队列</property>
                        <property name="AtkObject::accessible-description" translatable="yes" context="aichat|extended_tip|review_tree">列出待批写回与内容审查项，可「批准写回」或「拒绝」。</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkTreeViewColumn" id="review_item_column">
                        <property name="title" translatable="yes" context="aichat|review_item">项目</property>
                        <property name="resizable">True</property>
                        <child>
                          <object class="GtkCellRendererText" id="review_item_cell"/>
                          <attributes>
                            <attribute name="text">0</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkTreeViewColumn" id="review_state_column">
                        <property name="title" translatable="yes" context="aichat|review_state">状态</property>
                        <property name="resizable">True</property>
                        <child>
                          <object class="GtkCellRendererText" id="review_state_cell"/>
                          <attributes>
                            <attribute name="text">1</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">2</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="review_empty_label">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="halign">start</property>
                <property name="wrap">True</property>
                <property name="label" translatable="yes" context="aichat|review_empty">暂无待审项。发送 AI 结果后若产生待批写回，或对「产物」点「审查」，将出现在此列表。</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">3</property>
              </packing>
            </child>
            <child>
              <object class="GtkBox" id="review_action_box">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="halign">end</property>
                <property name="orientation">horizontal</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkButton" id="approve_selected_button">
                    <property name="label" translatable="yes" context="aichat|approve_selected">批准写回</property>
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="tooltip-text" translatable="yes" context="aichat|approve_tip">批准后才写入主文档（可撤销）</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="reject_selected_button">
                    <property name="label" translatable="yes" context="aichat|reject_selected">拒绝</property>
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">4</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="position">3</property>
          </packing>
        </child>
        <child type="tab">
          <object class="GtkLabel" id="review_tab_label">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="label" translatable="yes" context="aichat|tab_review">审核</property>
          </object>
          <packing>
            <property name="position">3</property>
            <property name="tab-fill">False</property>
          </packing>
        </child>
      </object>
      <packing>
        <property name="expand">True</property>
        <property name="fill">True</property>
        <property name="position">4</property>
      </packing>
    </child>
  </object>
</interface>